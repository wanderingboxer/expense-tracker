generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SyncStatus {
  IDLE
  SYNCING
  ERROR
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  REFUND
  CASH_WITHDRAWAL
  CASHBACK
  FEE
  INTEREST
  LOAN_PAYMENT
  INVESTMENT
  UNKNOWN
}

enum PaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  NET_BANKING
  WALLET
  CASH
  UNKNOWN
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  REFUNDED
}

enum CandidateStatus {
  PENDING
  MATCHED
  CREATED
  REJECTED
}

enum PersonalBusiness {
  PERSONAL
  BUSINESS
  REIMBURSABLE
  SHARED
}

enum AccountType {
  BANK
  CREDIT_CARD
  DEBIT_CARD
  WALLET
  CASH
  INVESTMENT
  LOAN
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ReviewType {
  POSSIBLE_DUPLICATE
  UNCERTAIN_CATEGORY
  UNKNOWN_MERCHANT
  POSSIBLE_TRANSFER
  POSSIBLE_REFUND
  UNKNOWN_TYPE
  LOW_CONFIDENCE
}

enum ReviewStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum RuleSource {
  USER
  LEARNED
  AI
  SYSTEM
}

// ─── NextAuth Models ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  gmailConnection  GmailConnection?
  financialEmails  FinancialEmail[]
  transactions     Transaction[]
  merchants        Merchant[]
  categories       Category[]
  categoryRules    CategoryRule[]
  financialAccounts FinancialAccount[]
  budgets          Budget[]
  subscriptions    Subscription[]
  reviewItems      ReviewItem[]
  insights         Insight[]
  savingsGoals     SavingsGoal[]
  auditLogs        AuditLog[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Gmail Integration ───────────────────────────────────────────────────────

model GmailConnection {
  id           String     @id @default(uuid())
  userId       String     @unique
  email        String
  accessToken  String     @db.Text
  refreshToken String     @db.Text
  historyId    BigInt?
  lastSyncAt   DateTime?
  syncStatus   SyncStatus @default(IDLE)
  errorMessage String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinancialEmail {
  id              String    @id @default(uuid())
  userId          String
  gmailMessageId  String    @unique
  gmailThreadId   String?
  sender          String
  senderDomain    String?
  subject         String?
  receivedAt      DateTime
  snippet         String?
  bodyText        String?   @db.Text
  bodyHtml        String?   @db.Text
  relevanceScore  Float?
  isFinancial     Boolean   @default(false)
  processedAt     DateTime?
  parserUsed      String?
  rawExtraction   Json?
  createdAt       DateTime  @default(now())

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionCandidates TransactionCandidate[]
  transactionEvidence  TransactionEvidence[]

  @@index([userId])
  @@index([receivedAt])
  @@index([senderDomain])
}

model TransactionCandidate {
  id               String          @id @default(uuid())
  financialEmailId String
  amount           Decimal
  currency         String          @default("INR")
  merchantRaw      String?
  transactionDate  DateTime?
  transactionTime  String?
  type             TransactionType @default(UNKNOWN)
  paymentMethod    PaymentMethod   @default(UNKNOWN)
  accountLast4     String?
  cardLast4        String?
  upiId            String?
  referenceNumber  String?
  utr              String?
  description      String?
  confidence       Float           @default(0)
  status           CandidateStatus @default(PENDING)
  createdAt        DateTime        @default(now())

  financialEmail FinancialEmail @relation(fields: [financialEmailId], references: [id], onDelete: Cascade)

  @@index([financialEmailId])
  @@index([status])
}

// ─── Core Financial Models ───────────────────────────────────────────────────

model Transaction {
  id                 String            @id @default(uuid())
  userId             String
  amount             Decimal
  currency           String            @default("INR")
  merchantId         String?
  type               TransactionType   @default(UNKNOWN)
  categoryId         String?
  transactionDate    DateTime
  transactionTime    String?
  paymentMethod      PaymentMethod     @default(UNKNOWN)
  financialAccountId String?
  accountLast4       String?
  cardLast4          String?
  upiId              String?
  referenceNumber    String?
  utr                String?
  status             TransactionStatus @default(COMPLETED)
  confidence         Float?
  isManual           Boolean           @default(false)
  isReviewed         Boolean           @default(false)
  isExcluded         Boolean           @default(false)
  notes              String?
  personalBusiness   PersonalBusiness  @default(PERSONAL)
  linkedTransactionId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant         Merchant?          @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  financialAccount FinancialAccount?  @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  linkedTransaction Transaction?      @relation("LinkedTransactions", fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  linkedFrom       Transaction[]      @relation("LinkedTransactions")
  evidence         TransactionEvidence[]
  reviewItems      ReviewItem[]       @relation("ReviewTransaction")
  relatedReviews   ReviewItem[]       @relation("RelatedTransaction")
  subscriptions    Subscription[]

  @@index([userId])
  @@index([transactionDate])
  @@index([amount])
  @@index([merchantId])
  @@index([categoryId])
  @@index([financialAccountId])
  @@index([linkedTransactionId])
  @@index([status])
}

model TransactionEvidence {
  id               String   @id @default(uuid())
  transactionId    String
  financialEmailId String
  matchConfidence  Float
  matchReasons     Json
  createdAt        DateTime @default(now())

  transaction    Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  financialEmail FinancialEmail @relation(fields: [financialEmailId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([financialEmailId])
}

// ─── Merchant & Category ─────────────────────────────────────────────────────

model Merchant {
  id                String   @id @default(uuid())
  userId            String
  name              String
  normalizedName    String
  logoUrl           String?
  website           String?
  defaultCategoryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCategory Category?       @relation("MerchantDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  aliases         MerchantAlias[]
  transactions    Transaction[]
  categoryRules   CategoryRule[]
  subscriptions   Subscription[]

  @@index([userId])
  @@index([normalizedName])
  @@index([defaultCategoryId])
}

model MerchantAlias {
  id              String     @id @default(uuid())
  merchantId      String
  alias           String
  normalizedAlias String
  source          RuleSource @default(SYSTEM)
  createdAt       DateTime   @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([normalizedAlias])
}

model Category {
  id       String  @id @default(uuid())
  userId   String?
  name     String
  icon     String?
  color    String?
  parentId String?
  isSystem Boolean @default(false)
  sortOrder Int    @default(0)
  createdAt DateTime @default(now())

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[]     @relation("CategoryHierarchy")
  transactions  Transaction[]
  categoryRules CategoryRule[]
  budgets       Budget[]
  subscriptions Subscription[]
  merchants     Merchant[]     @relation("MerchantDefaultCategory")

  @@index([userId])
  @@index([parentId])
}

model CategoryRule {
  id                  String     @id @default(uuid())
  userId              String
  merchantId          String?
  merchantNamePattern String?
  categoryId          String
  source              RuleSource @default(USER)
  confidence          Float      @default(1.0)
  applyCount          Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([merchantId])
  @@index([categoryId])
}

// ─── Financial Account ───────────────────────────────────────────────────────

model FinancialAccount {
  id              String      @id @default(uuid())
  userId          String
  name            String
  type            AccountType
  institutionName String?
  last4           String?
  isOwn           Boolean     @default(true)
  isArchived      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

// ─── Budget & Subscription ───────────────────────────────────────────────────

model Budget {
  id         String       @id @default(uuid())
  userId     String
  categoryId String?
  name       String
  amount     Decimal
  period     BudgetPeriod
  startDate  DateTime
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categoryId])
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String
  merchantId       String?
  transactionId    String?
  name             String
  amount           Decimal
  currency         String    @default("INR")
  frequency        Frequency
  nextExpectedDate DateTime?
  lastChargeDate   DateTime?
  isActive         Boolean   @default(true)
  categoryId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant    Merchant?    @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([merchantId])
  @@index([transactionId])
  @@index([categoryId])
}

// ─── Review & Insights ───────────────────────────────────────────────────────

model ReviewItem {
  id                   String       @id @default(uuid())
  userId               String
  type                 ReviewType
  status               ReviewStatus @default(PENDING)
  transactionId        String?
  relatedTransactionId String?
  suggestedAction      Json?
  userAction           Json?
  createdAt            DateTime     @default(now())
  resolvedAt           DateTime?

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction        Transaction? @relation("ReviewTransaction", fields: [transactionId], references: [id], onDelete: Cascade)
  relatedTransaction Transaction? @relation("RelatedTransaction", fields: [relatedTransactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([transactionId])
  @@index([relatedTransactionId])
}

model Insight {
  id          String    @id @default(uuid())
  userId      String
  type        String
  title       String
  description String?   @db.Text
  data        Json?
  priority    Int       @default(0)
  isRead      Boolean   @default(false)
  isDismissed Boolean   @default(false)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

// ─── Goals & Audit ───────────────────────────────────────────────────────────

model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal
  currentAmount Decimal   @default(0)
  deadline      DateTime?
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
