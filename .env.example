# Database - Vercel Postgres (auto-populated when you add Vercel Postgres integration)
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# Or use a direct DATABASE_URL for local dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financeflow?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gemini API (aistudio.google.com)
GEMINI_API_KEY=""

# Secret required in the Authorization: Bearer header for /api/cron/sync
CRON_SECRET="generate-with-openssl-rand-base64-32"

# How many days back the first-ever Gmail sync backfills (default 180)
SYNC_LOOKBACK_DAYS="180"
